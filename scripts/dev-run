#!/usr/bin/env bash
set -euo pipefail

project_dir="${DEV_PROJECT_DIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"

# Build in a child shell so its data-directory and build settings cannot replace
# the caller's environment. Only native runtime settings cross this boundary.
runtime_settings="$(
  cd "$project_dir"
  nix develop --no-write-lock-file .#default --command bash -c '
    set -euo pipefail
    export CARGO_TARGET_DIR="$PWD/src-tauri/target"
    pnpm install --frozen-lockfile >&2
    pnpm desktop:build --debug >&2
    for name in GIO_MODULE_DIR __EGL_VENDOR_LIBRARY_FILENAMES GBM_BACKENDS_PATH LIBGL_DRIVERS_PATH; do
      printf "%s=%s\n" "$name" "${!name}"
    done
  '
)"

runtime_environment=()
while IFS= read -r setting; do
  case "$setting" in
    GIO_MODULE_DIR=*|__EGL_VENDOR_LIBRARY_FILENAMES=*|GBM_BACKENDS_PATH=*|LIBGL_DRIVERS_PATH=*)
      runtime_environment+=("$setting")
      ;;
    *)
      echo "jupsql dev: unexpected output while reading the native runtime settings" >&2
      exit 1
      ;;
  esac
done <<< "$runtime_settings"

exec env "${runtime_environment[@]}" "$project_dir/src-tauri/target/debug/jupsql" "$@"
